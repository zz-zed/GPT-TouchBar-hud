# SwiftPM, application builds and local packaging output (repository root only).
/.build/
/.swiftpm/
/build/
/DerivedData/
/dist/

# Local recovery copies and working output.
/backups/
/Design/
/.local/
xcuserdata/

# OS/editor files and machine-specific artifact preview sessions.
.DS_Store
*.swp
*.swo
*~
.artifact-server.json

# Local credentials; sanitized setup templates remain versionable.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Runtime logs and raw validation records stay local.
*.log
/Documentation/validation/
/Documentation/**/evidence/
/Documentation/archive/

# Temporary checkouts and staging used by the release workflows.
/.release-tools/
/release-source/
/release-stage/

# Rebuildable Python bytecode.
__pycache__/
*.pyc

# Development process material belongs outside the repository. These are safeguards.
**/task_plan.md
**/execution-log.md
**/session-transcript.*
**/raw-prompts.*
**/.codex/sessions/
**/.claude/worktrees/
